rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      // Allow read if user is online or if it's the user's own document
      allow read: if request.auth != null && 
        (resource.data.status == 'online' || 
         resource.data.status == 'searching' || 
         resource.data.status == 'connected' ||
         request.auth.uid == userId);
      
      // Allow write if it's the user's own document
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Queue collection
    match /queue/{userId} {
      // Allow read for all authenticated users (needed for matchmaking)
      allow read: if request.auth != null;
      
      // Allow write if it's the user's own queue document
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Allow delete if it's the user's own queue document
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Matches collection
    match /matches/{matchId} {
      // Allow read if user is part of the match
      allow read: if request.auth != null && 
        request.auth.uid in resource.data.users;
      
      // Allow create if user is authenticated (transaction will handle validation)
      allow create: if request.auth != null;
      
      // Allow update if user is part of the match
      allow update: if request.auth != null && 
        request.auth.uid in resource.data.users;
      
      // Allow delete if user is part of the match
      allow delete: if request.auth != null && 
        request.auth.uid in resource.data.users;
    }
    
    // Messages collection
    match /messages/{messageId} {
      // Allow read if user is part of the match
      allow read: if request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.users;
      
      // Allow create if user is authenticated and is part of the match
      allow create: if request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.users &&
        request.resource.data.senderId == request.auth.uid;
      
      // Allow update if user is the sender
      allow update: if request.auth != null && 
        resource.data.senderId == request.auth.uid;
      
      // Allow delete if user is part of the match
      allow delete: if request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.users;
    }
    
    // Presence collection
    match /presence/{userId} {
      // Allow read for all authenticated users (needed for online count and typing indicators)
      allow read: if request.auth != null;
      
      // Allow write if it's the user's own presence document
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Allow delete if it's the user's own presence document
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
